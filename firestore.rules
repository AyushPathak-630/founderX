rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidRegistration(data) {
      return data.keys().hasAll(['fullName', 'email', 'phone', 'college', 'branch', 'year', 'hasStartupIdea', 'experienceLevel', 'termsAccepted', 'paymentStatus', 'createdAt']) &&
             data.keys().size() >= 11 && data.keys().size() <= 14 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 20 &&
             data.college is string && data.college.size() > 0 && data.college.size() <= 100 &&
             data.branch is string && data.branch.size() > 0 && data.branch.size() <= 100 &&
             data.year is string && data.year.size() > 0 && data.year.size() <= 10 &&
             data.hasStartupIdea is string && data.hasStartupIdea.size() > 0 && data.hasStartupIdea.size() <= 10 &&
             data.experienceLevel is string && data.experienceLevel.size() > 0 && data.experienceLevel.size() <= 20 &&
             data.termsAccepted is bool &&
             data.paymentStatus is string && data.paymentStatus.size() > 0 && data.paymentStatus.size() <= 20 &&
             data.createdAt is timestamp;
    }

    match /registrations/{registrationId} {
      allow read: if true; // Since the app displays recent registrations
      allow create: if isValidRegistration(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
